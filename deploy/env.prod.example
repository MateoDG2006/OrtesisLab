# Copie a deploy/.env y complete dominios y claves. No versione deploy/.env.
# DNS de APP_HOST y S3_HOST debe apuntar a este servidor (puertos 80 y 443 abiertos).

# Dominios públicos (sin esquema). Caddy pide certificados Let's Encrypt.
APP_HOST=app.ejemplo.com
S3_HOST=s3.ejemplo.com

# Correo de contacto de Let's Encrypt (opcional pero recomendado).
ACME_EMAIL=ops@ejemplo.com

# PostgreSQL
POSTGRES_DB=ortesislab
POSTGRES_USER=ortesislab_admin
POSTGRES_PASSWORD=cambie-admin-fuerte

ORTESISLAB_MIGRATOR_PASSWORD=cambie-migrador-fuerte
ORTESISLAB_APP_PASSWORD=cambie-app-fuerte
ORTESISLAB_WORKER_PASSWORD=cambie-trabajador-fuerte
ORTESISLAB_BACKUP_PASSWORD=cambie-backup-fuerte

# MinIO (raíz y cuenta de la aplicación). Imágenes: forks públicos; MinIO Inc. ya no publica.
MINIO_IMAGE=pgsty/silo:RELEASE.2026-11-12T00-00-00Z
MC_IMAGE=pgsty/mc:RELEASE.2026-11-12T00-00-00Z
MINIO_ROOT_USER=ortesislab-root
MINIO_ROOT_PASSWORD=cambie-root-minio-fuerte
ORTESISLAB_S3_ACCESS_KEY=ortesislab-app
ORTESISLAB_S3_SECRET_KEY=cambie-secreto-s3-fuerte
ORTESISLAB_S3_BUCKET=ortesislab
ORTESISLAB_S3_REGION=us-east-1
ORTESISLAB_S3_CORS_ORIGINS=https://app.ejemplo.com
ORTESISLAB_REDIS_MAXMEMORY=256mb

# URL internas (Compose). El navegador usa las públicas de abajo.
ORTESISLAB_DATABASE_URL=postgresql+psycopg://ortesislab_app:cambie-app-fuerte@postgres:5432/ortesislab
ORTESISLAB_WORKER_DATABASE_URL=postgresql+psycopg://ortesislab_worker:cambie-trabajador-fuerte@postgres:5432/ortesislab
ORTESISLAB_MIGRATOR_DATABASE_URL=postgresql+psycopg://ortesislab_migrator:cambie-migrador-fuerte@postgres:5432/ortesislab
ORTESISLAB_S3_ENDPOINT=http://minio:9000
ORTESISLAB_REDIS_URL=redis://redis:6379/0

# URL públicas (navegador y cookies)
ORTESISLAB_S3_PUBLIC_URL=https://s3.ejemplo.com
ORTESISLAB_APP_URL=https://app.ejemplo.com
ORTESISLAB_COOKIE_SECURE=true
